# ============================================================================
# SRMS — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# --- Database (PostgreSQL) --------------------------------------------------
# Example (local): postgresql://postgres:postgres@localhost:5432/srems?schema=public
#
# --- Using Supabase? -----------------------------------------------------
# Supabase gives you TWO connection strings (Project Settings > Database):
#   1. "Connection pooling" (port 6543, uses pgbouncer) -> DATABASE_URL
#      Add `?pgbouncer=true&connection_limit=1` to the end of it.
#   2. "Connection string" / direct (port 5432)          -> DIRECT_URL
#      Used only by `prisma migrate` to run schema migrations.
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Auth --------------------------------------------------------------------
# Generate a strong random secret, e.g.: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret-value"

# --- App -----------------------------------------------------------------
# Public base URL of the deployed app (used to build email links).
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# --- Email (Nodemailer / SMTP) -----------------------------------------
# For Gmail: create an "App Password" (Google Account > Security > App
# passwords) — do NOT use your normal account password.
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-smtp-user@example.com"
EMAIL_PASSWORD="your-smtp-app-password"

# If EMAIL_USER / EMAIL_PASSWORD are left unset, the app logs verification
# and password-reset emails to the server console instead of sending them —
# convenient for local development, but must be configured before deploying.
